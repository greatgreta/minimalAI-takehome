{
  "name": "minimal-takehome",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:pages && npm run build:agent",
    "build:pages": "vite build",
    "build:agent": "vite build --config vite.agent.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "shots": "node scripts/shots.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.1.0",
    "@fontsource/eb-garamond": "^5.1.0",
    "@fontsource/inter": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
